{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "paths": {
      "@components/*": ["./lib/components/*"],
      "@core/*": ["./lib/core/*"],
      "@assets/*": ["./lib/assets/*"],
      "@consumidor-positivo/aurora/astro/runtime": ["./lib/astro/runtime"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vitest", "astro/client"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `.astro` is spelled out: a bare folder in `include` only matches TypeScript
  // extensions, so the editor's language server saw the `.astro` files as
  // outside any project and fell back to a config without `moduleResolution`,
  // where `astro/types` cannot resolve. `astro check` builds its own program
  // and never hit it.
  "include": ["lib", "scripts", "lib/**/*.astro", ".astro/types.d.ts"],
  "exclude": ["node_modules"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
