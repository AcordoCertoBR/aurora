---
import type { HTMLAttributes } from 'astro/types'

export type Props = HTMLAttributes<'div'> & {
  divider?: boolean
}

const { divider = false, class: className, ...rest } = Astro.props
---

<div
  class:list={[
    'au-header__actions',
    divider && 'au-header__actions--divider',
    className,
  ]}
  {...rest}>
  <slot />
</div>
