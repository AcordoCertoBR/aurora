---
import type { HTMLAttributes } from 'astro/types'
import Icon from '../../Icon/index.astro'

export type NotificationsConfig = {
  visible?: boolean
  count?: number
  hasUnread?: boolean
}

/**
 * The React version takes `onClickMenu` and `notifications.onClick`. Astro has
 * no callback props: the buttons carry `data-au-header-profile` values so the
 * page's own `<script>` can wire them.
 */
export type Props = HTMLAttributes<'div'> & {
  fullName: string
  notifications?: NotificationsConfig
}

const {
  fullName,
  notifications = {},
  class: className,
  ...rest
} = Astro.props

const { visible = true, hasUnread = false, count } = notifications
const shouldShowBadge = (count && count > 0) || hasUnread

const initialLetters = fullName
  ?.split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('')

const MENU_ICON = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M2 12C2 11.4477 2.44772 11 3 11H21C21.5523 11 22 11.4477 22 12C22 12.5523 21.5523 13 21 13H3C2.44772 13 2 12.5523 2 12Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="M2 6C2 5.44772 2.44772 5 3 5H21C21.5523 5 22 5.44772 22 6C22 6.55228 21.5523 7 21 7H3C2.44772 7 2 6.55228 2 6Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="M2 18C2 17.4477 2.44772 17 3 17H21C21.5523 17 22 17.4477 22 18C22 18.5523 21.5523 19 21 19H3C2.44772 19 2 18.5523 2 18Z" fill="currentColor"/></svg>`
const CHEVRON_ICON = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M5.29289 8.29289C5.68342 7.90237 6.31658 7.90237 6.70711 8.29289L12 13.5858L17.2929 8.29289C17.6834 7.90237 18.3166 7.90237 18.7071 8.29289C19.0976 8.68342 19.0976 9.31658 18.7071 9.70711L12.7071 15.7071C12.3166 16.0976 11.6834 16.0976 11.2929 15.7071L5.29289 9.70711C4.90237 9.31658 4.90237 8.68342 5.29289 8.29289Z" fill="currentColor"/></svg>`
const BELL_ICON = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M7.05033 3.05025C8.36309 1.7375 10.1436 1 12.0001 1C13.8566 1 15.6371 1.7375 16.9498 3.05025C18.2626 4.36301 19.0001 6.14349 19.0001 8C19.0001 11.3527 19.7171 13.4346 20.378 14.6461C20.7098 15.2544 21.0329 15.6535 21.2573 15.8904C21.3698 16.0091 21.4581 16.0878 21.5114 16.1322C21.538 16.1544 21.5558 16.168 21.5635 16.1737C21.5647 16.1746 21.5657 16.1753 21.5664 16.1758C21.9249 16.4221 22.0835 16.8725 21.9572 17.2898C21.8295 17.7115 21.4407 18 21.0001 18H3.00008C2.55941 18 2.17068 17.7115 2.04299 17.2898C1.91664 16.8725 2.07528 16.4221 2.43377 16.1758C2.43447 16.1753 2.43542 16.1746 2.43663 16.1737C2.44432 16.168 2.46218 16.1544 2.4888 16.1322C2.54202 16.0878 2.6304 16.0091 2.74288 15.8904C2.9673 15.6535 3.29039 15.2544 3.62218 14.6461C4.28301 13.4346 5.00008 11.3527 5.00008 8C5.00008 6.14348 5.73758 4.36301 7.05033 3.05025ZM2.44388 16.169C2.44395 16.1689 2.44403 16.1688 2.44411 16.1688C2.44411 16.1688 2.4441 16.1688 2.4441 16.1688L2.44388 16.169ZM5.1494 16H18.8508C18.7747 15.8753 18.6983 15.7434 18.6222 15.6039C17.783 14.0654 17.0001 11.6473 17.0001 8C17.0001 6.67392 16.4733 5.40215 15.5356 4.46447C14.5979 3.52678 13.3262 3 12.0001 3C10.674 3 9.40223 3.52678 8.46454 4.46447C7.52686 5.40215 7.00008 6.67392 7.00008 8C7.00008 11.6473 6.21715 14.0654 5.37797 15.6039C5.30188 15.7434 5.22549 15.8753 5.1494 16Z" fill="currentColor"/><path fill-rule="evenodd" clip-rule="evenodd" d="M9.76792 20.1352C10.2457 19.858 10.8576 20.0207 11.1347 20.4984C11.2226 20.6499 11.3488 20.7757 11.5006 20.8632C11.6524 20.9506 11.8245 20.9966 11.9997 20.9966C12.1749 20.9966 12.347 20.9506 12.4988 20.8632C12.6506 20.7757 12.7768 20.6499 12.8647 20.4984C13.1418 20.0207 13.7537 19.858 14.2315 20.1352C14.7092 20.4123 14.8718 21.0242 14.5947 21.5019C14.331 21.9566 13.9525 22.3339 13.497 22.5962C13.0416 22.8586 12.5253 22.9966 11.9997 22.9966C11.4741 22.9966 10.9578 22.8586 10.5024 22.5962C10.0469 22.3339 9.66841 21.9566 9.4047 21.5019C9.12758 21.0242 9.2902 20.4123 9.76792 20.1352Z" fill="currentColor"/></svg>`
---

<div class:list={['au-header__profile', className]} {...rest}>
  {
    visible && (
      <button
        type="button"
        class="au-header__profile-notifications"
        data-au-header-profile="notifications"
        aria-label={
          shouldShowBadge
            ? `Notificações, ${count && count > 0 ? count : 'novas'}`
            : 'Notificações'
        }>
        <Icon markup={BELL_ICON} name="IconBell" aria-hidden="true" />
        {shouldShowBadge && (
          <span class="au-header__profile-notifications-badge" aria-hidden="true">
            {count && count > 0 ? count : null}
          </span>
        )}
      </button>
    )
  }

  <button
    type="button"
    class="au-header__profile-menu-mobile"
    data-au-header-profile="menu"
    aria-label="Abrir menu de perfil">
    <Icon markup={MENU_ICON} name="IconMenu" aria-hidden="true" />
  </button>

  <button
    type="button"
    class="au-header__profile-menu"
    data-au-header-profile="menu"
    aria-label={`Menu de ${fullName}`}>
    <span class="au-header__profile-letters" aria-hidden="true">
      {initialLetters}
    </span>
    <Icon markup={CHEVRON_ICON} name="IconChevronDown" aria-hidden="true" />
  </button>
</div>
