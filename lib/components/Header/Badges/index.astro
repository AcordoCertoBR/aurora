---
import type { HTMLAttributes } from 'astro/types'

export type Props = HTMLAttributes<'div'> & {
  limitBadgeWidth?: boolean
}

const { limitBadgeWidth = true, class: className, ...rest } = Astro.props
---

<div
  class:list={[
    'au-header__badges',
    limitBadgeWidth && 'au-header__badges--limited-width',
    className,
  ]}
  {...rest}>
  <slot />
</div>
