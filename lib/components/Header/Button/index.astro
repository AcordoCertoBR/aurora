---
import type { HTMLAttributes } from 'astro/types'

/**
 * The React version takes an `onClick`. Astro has no callback props: pass an
 * `id` or a `data-*` attribute and wire the listener from the page's own
 * `<script>`.
 */
export type Props = Omit<HTMLAttributes<'button'>, 'type'>

const { class: className, ...rest } = Astro.props
---

<button type="button" class:list={['au-header__button', className]} {...rest}>
  <slot />
</button>
